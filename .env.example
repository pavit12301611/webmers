# ---------------------------------------------------------------------------
# Webmers environment variables
#
# NONE of these are required to run the app. Out of the box Webmers runs fully
# self-contained with an in-memory data store and demo data (see README).
# Provide the values below only when you want to enable optional integrations.
# ---------------------------------------------------------------------------

# --- Auth (recommended in production) -------------------------------------
# A random secret used to sign JWT sessions. A dev fallback is used if unset.
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Database (optional) ---------------------------------------------------
# When set AND a generated Prisma client is available, the data layer reads
# from PostgreSQL via Prisma. Otherwise the in-memory store is used.
# After setting this, run: npm run db:generate && npm run db:push && npm run db:seed
DATABASE_URL=""

# --- Google OAuth (optional) ----------------------------------------------
# When both are set, "Continue with Google" appears on the sign-in page.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments / email / storage (placeholders for future integration) -----
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
RESEND_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
