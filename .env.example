# ---------------------------------------------------------------------------
# Webmers environment variables
#
# NONE of these are required to run the app. Out of the box Webmers runs fully
# self-contained with an in-memory data store and demo data (see README).
# Provide the values below only when you want to enable optional integrations.
# ---------------------------------------------------------------------------

# --- Auth (recommended in production) -------------------------------------
# A random secret used to sign JWT sessions. Required in production (use: openssl rand -base64 32).
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Database (optional) ---------------------------------------------------
# When set AND a generated Prisma client is available, the data layer reads
# from PostgreSQL via Prisma. Otherwise the in-memory store is used.
# After setting this, run: npm run db:generate && npm run db:push && npm run db:seed
DATABASE_URL=""

# --- Google Search Console -------------------------------------------------
# Paste the content value from Search Console's HTML meta-tag verification.
GOOGLE_SITE_VERIFICATION=""

# --- Google OAuth (optional) ----------------------------------------------
# When both are set, "Continue with Google" appears on the sign-in & sign-up pages.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email for Forgot Password (ZERO API KEY NEEDED) ----------------------
# By default, the app uses Ethereal (completely free, no signup, no limits).
# It creates a real temporary inbox — you'll see a "View email" link in the UI + console.
#
# For REAL production emails (still free forever):
# 1. Go to https://www.brevo.com (300 emails/day free tier)
# 2. Create an SMTP account
# 3. Fill the variables below:
#
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-brevo-login@domain.com"
# SMTP_PASS="your-brevo-smtp-password"
# SMTP_FROM="Webmers <no-reply@yourdomain.com>"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Payments / storage (placeholders) ------------------------------------
# Razorpay UPI / QR payments (recommended for India).
# Configure payment.captured webhook -> https://your-domain.com/api/payments/razorpay/webhook
RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_..."
RAZORPAY_WEBHOOK_SECRET=""

# Legacy placeholders; do not enable demo payment mode in production.
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENTS_DEMO_MODE="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
