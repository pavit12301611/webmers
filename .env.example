# ---------------------------------------------------------------------------
# Webmers environment variables
#
# For LOCAL DEVELOPMENT none of these are required — Webmers runs fully
# self-contained with a seeded data store and demo accounts (see README).
#
# For PRODUCTION, NEXTAUTH_SECRET is mandatory and a DATABASE_URL + SMTP
# transport are strongly recommended. See the Production checklist in README.
# ---------------------------------------------------------------------------

# --- Auth (REQUIRED in production) -----------------------------------------
# Signs JWT session cookies. The app REFUSES TO START in production without it,
# because a shared/guessable secret lets anyone forge a session for any account.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Allow a Google sign-in to auto-link to an existing password account with the
# same email. Off by default: it can enable account takeover. Opt in knowingly.
GOOGLE_ALLOW_ACCOUNT_LINKING="false"

# --- Database (required for multi-instance / production) -------------------
# When set AND a generated Prisma client is available, the data layer reads
# from PostgreSQL via Prisma. Otherwise the built-in store is used and
# snapshotted to .data/store.json (single instance only).
# After setting this, run: npm run db:generate && npm run db:push && npm run db:seed
DATABASE_URL=""

# --- Google OAuth (optional) ----------------------------------------------
# When both are set, "Continue with Google" appears on the sign-in & sign-up pages.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email for Forgot Password (ZERO API KEY NEEDED) ----------------------
# By default, the app uses Ethereal (completely free, no signup, no limits).
# It creates a real temporary inbox — you'll see a "View email" link in the UI + console.
#
# For REAL production emails (still free forever):
# 1. Go to https://www.brevo.com (300 emails/day free tier)
# 2. Create an SMTP account
# 3. Fill the variables below:
#
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="your-brevo-login@domain.com"
# SMTP_PASS="your-brevo-smtp-password"
# SMTP_FROM="Webmers <no-reply@yourdomain.com>"

SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Local data snapshot ----------------------------------------------------
# Set to 0 to disable the .data/store.json snapshot (pure in-memory).
# Automatically disabled when DATABASE_URL is set or the FS is read-only.
WEBMERS_PERSIST="1"

# --- Payments / storage (placeholders) ------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
