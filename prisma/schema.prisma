generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role      @default(BUYER)
  avatarUrl     String?
  passwordHash  String?
  twoFAEnabled  Boolean   @default(false)
  twoFASecret   String?
  /// Bumped on password reset to invalidate previously issued JWTs.
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  listings      Listing[] @relation("SellerListings")
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
  messages      Message[] @relation("BuyerMessages")
  messagesSent  Message[] @relation("SellerMessages")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model Listing {
  id            String    @id @default(uuid())
  title         String
  /// Short one-line summary shown on cards; falls back to description.
  tagline       String?
  description   String
  price         Float
  /// Denormalised aggregates so listing cards don't need a join.
  rating        Float     @default(0)
  sales         Int       @default(0)
  featured      Boolean   @default(false)
  category      String
  techStack     String[]
  images        String[]
  videoPreview  String?
  demoUrl       String?
  status        ListingStatus @default(DRAFT)
  sellerId      String
  seller        User      @relation("SellerListings", fields: [sellerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist[]
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  PAUSED
}

model Order {
  id            String    @id @default(uuid())
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id])
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  amount        Float
  status        OrderStatus @default(PENDING)
  layoutChoice  String?
  codeUnlocked  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  editorState   EditorState?
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  REFUNDED
  DISPUTED
}

model Review {
  id            String    @id @default(uuid())
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id])
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  rating        Int
  comment       String?
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model Wishlist {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id])
  createdAt     DateTime  @default(now())
}

model Message {
  id            String    @id @default(uuid())
  buyerId       String
  buyer         User      @relation("BuyerMessages", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("SellerMessages", fields: [sellerId], references: [id])
  content       String
  createdAt     DateTime  @default(now())
}

/// Saved visual-editor document for one purchased order.
model EditorState {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  theme         String   @default("Night")
  accent        String   @default("#ffffff")
  font          String   @default("Inter")
  sections      Json
  content       Json
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
